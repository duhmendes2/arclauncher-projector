<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E1114"
    android:clipToPadding="false"
    android:paddingStart="48dp"
    android:paddingTop="36dp"
    android:paddingEnd="48dp"
    android:paddingBottom="48dp">

    <LinearLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_light"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp" />

        <!-- Colunas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/columns_label"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>

        <!-- Linhas abaixo do Dock -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/rows_below_dock_label"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
        </LinearLayout>

        <!-- Seção Recursos de Projetor & Cinema -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="📽️ Recursos de Projetor &amp; Cinema"
            android:textColor="#FFFFD600"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_medium" />

        <TextView
            android:id="@+id/calibrationChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:text="🎯 Calibrar Foco &amp; Keystone (Padrão de Imagem)" />

        <TextView
            android:id="@+id/sleepTimerChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="⏱️ Temporizador de Desligamento (Sleep Timer)" />

        <TextView
            android:id="@+id/screenOffChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="📻 Apagar Tela (Modo Apenas Áudio)" />

        <TextView
            android:id="@+id/whaleUnlockerChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="🔓 Destravador do Sistema (Whale OS / Bettdow)" />

        <TextView
            android:id="@+id/screensaverChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="🌙 Protetor de Tela Inativo" />

        <TextView
            android:id="@+id/nightDimmerChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="🕶️ Dimmer de Cinema (Filtro Escurecedor)" />

        <TextView
            android:id="@+id/appHideChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="🚫 Gerenciar Aplicativos (Ocultar Bloatware)" />

        <TextView
            android:id="@+id/projectorSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="⚙️ Ajustes Nativos do Projetor (Keystone do Sistema)" />

        <!-- Papéis de Parede -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="🎨 Papel de Parede"
            android:textColor="#FFFFD600"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_medium" />

        <TextView
            android:id="@+id/pickLocalWallpaperChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp"
            android:text="📂 Escolher da Memória Interna / Pendrive" />

        <TextView
            android:id="@+id/cinemaWallpaperChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp"
            android:text="🎬 Catálogo de Cinema TMDB (1080p)" />

        <TextView
            android:id="@+id/wallpaperChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <!-- Animações -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="✨ Desempenho &amp; Efeitos"
            android:textColor="#FFFFD600"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_medium" />

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/advancedChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/advanced_effects_warning"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/followThemeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/follow_theme" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/follow_theme_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <!-- Sistema -->
        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/home_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/home_settings_help"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/tv_settings" />
    </LinearLayout>
</ScrollView>
